# Base URL of the Dashboard backend API (e.g. http://localhost:3002/api/v1)
NEXT_PUBLIC_API_URL=

# Socket.IO / realtime server URL (usually the same host as the API)
NEXT_PUBLIC_WS_URL=

# Base URL of the University/LMS API
NEXT_PUBLIC_UNIVERSITY_API_URL=

# Server-only key used by the AI assistant route handler (src/app/api/chat)
OPENAI_API_KEY=

PORT=3000
